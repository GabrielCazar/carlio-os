+/*
+ * Test-only hot unplug. Hold slot submission at PxCI so no backend DMA has
+ * started, then detach the sole disk from port 0 via DEVICE_DELETED.
+ */
+static bool test_hold_get(Object *obj, Error **errp)
+{
+    return ICH9_AHCI(obj)->ahci.test_hold_port0;
+}
+
+static void test_hold_set(Object *obj, bool value, Error **errp)
+{
+    AHCIState *s = &ICH9_AHCI(obj)->ahci;
+
+    if (!s->dev || !s->dev[0].port.ifs[0].blk ||
+        s->dev[0].port_regs.cmd_issue) {
+        error_setg(errp, "Changing the test hold requires an idle attached port 0");
+        return;
+    }
+    if (!value && !s->test_comreset_port0) {
+        error_setg(errp, "Releasing the test hold requires a COMRESET");
+        return;
+    }
+    qbus_set_hotplug_handler(BUS(&s->dev[0].port), value ? obj : NULL);
+    s->test_hold_port0 = value;
+    s->test_comreset_port0 = false;
+}
+
+static bool test_link_get(Object *obj, Error **errp)
+{
+    AHCIState *s = &ICH9_AHCI(obj)->ahci;
+
+    return s->dev && s->dev[0].port.ifs[0].blk;
+}
+
+static void test_unplug(HotplugHandler *handler, DeviceState *dev, Error **errp)
+{
+    AHCIState *s = &ICH9_AHCI(OBJECT(handler))->ahci;
+    AHCIDevice *ad = &s->dev[0];
+
+    if (!s->test_hold_port0 || !ad->port.master ||
+        dev != &ad->port.master->qdev ||
+        ad->port_regs.cmd_issue != 1 || ad->port.dma->aiocb ||
+        !ad->port.ifs[0].blk || ad->port.ifs[0].drive_kind != IDE_HD) {
+        error_setg(errp, "Test unplug requires a held command on SATA port 0");
+        return;
+    }
+    blk_set_dev_ops(ad->port.ifs[0].blk, NULL, NULL);
+    ad->port.ifs[0].blk = NULL;
+    ad->port.master = NULL;
+    ad->port_regs.cmd_issue = 0;
+    ad->port_regs.sig = UINT32_MAX;
+    ad->port_regs.scr_err |= 1U << 16; /* PhyRdy changed */
+    ad->port_regs.irq_stat |= (1U << AHCI_PORT_IRQ_BIT_PRCS) |
+                              (1U << AHCI_PORT_IRQ_BIT_PCS);
+    qdev_simple_device_unplug_cb(handler, dev, errp);
+}
+

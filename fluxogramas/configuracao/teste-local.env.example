# Exemplo opcional: carregue manualmente com `source` antes do teste local.
# Este arquivo não contém segredos e não é carregado pelo sistema instalado.
CARLIO_TEST_PHASE=fase-local
CARLIO_TEST_OVMF=/usr/share/edk2/x64/OVMF_CODE.4m.fd

# Não habilite testes de escrita em unidades reais; o harness QEMU cria mídia
# descartável temporária. A variável de storage-test é usada pelo build ISO.
# CARLIO_STORAGE_TEST=1
